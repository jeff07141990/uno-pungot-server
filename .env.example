# Client Environment Variables
VITE_SERVER_PORT=3001
# Optional: Set this to your LAN IP or deployed WebSocket/HTTP server URL if testing across devices:
# e.g. VITE_SERVER_URL=http://192.168.1.100:3001
VITE_SERVER_URL=

# Firebase Client Configuration (Optional for persistence & cloud auth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server Configuration
PORT=3001
